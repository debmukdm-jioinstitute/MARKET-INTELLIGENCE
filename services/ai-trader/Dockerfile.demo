# Minimal demo algo desk — no DB, no ML weights (Fly free tier friendly).
FROM python:3.13-slim-bookworm

WORKDIR /app

RUN pip install --no-cache-dir flask flask-cors gunicorn

COPY scripts/demo_desk.py ./demo_desk.py

ENV PORT=5050
EXPOSE 5050

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5050/api/state', timeout=3)"

CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:5050", "demo_desk:app"]
